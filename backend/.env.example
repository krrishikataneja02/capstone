ENV=dev
DATABASE_URL=mysql+pymysql://twin:local-only-app-password@localhost:3306/digital_twin?charset=utf8mb4
SECRET_KEY=change-me-in-dev-or-set-your-own-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_SECONDS=10
CAMPUS_TIMEZONE=Asia/Kolkata

# Local Docker Compose credentials only; replace with unique values outside development.
MYSQL_ROOT_PASSWORD=local-only-root-password
MYSQL_USER=twin
MYSQL_PASSWORD=local-only-app-password
